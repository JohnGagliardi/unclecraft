<Project Sdk="Microsoft.NET.Sdk">
  <!-- Signs a release for the workflow (.github/workflows/release.yml), using the same ReleaseSig.cs the app verifies with. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sign-release</AssemblyName>
    <RootNamespace>McShared</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\ReleaseSig.cs" />
  </ItemGroup>
</Project>
