<Project>
  <!-- Version from git for builds from source (see Directory.Build.props). Runs before the SDK derives AssemblyVersion
       and FileVersion (GetAssemblyVersion) and before it appends +<commit> to InformationalVersion, so all four agree.
       Skipped when a Version was passed in (the release workflow). -->
  <Target Name="UncleCraftVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo"
          Condition="'$(UncleCraftVersionGiven)' != 'true'">
    <PropertyGroup>
      <_UcRepo>$(MSBuildThisFileDirectory)</_UcRepo>
      <_UcTag></_UcTag>
    </PropertyGroup>
    <!-- .git is a folder in a clone and a file in a worktree; neither means a copy without history: keep 0.2.0. -->
    <Exec Condition="Exists('$(_UcRepo).git')" Command="git describe --tags --match &quot;v[0-9]*&quot; --abbrev=0"
          WorkingDirectory="$(_UcRepo)" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_UcTag" />
      <Output TaskParameter="ExitCode" PropertyName="_UcGitExit" />
    </Exec>
    <PropertyGroup>
      <_UcTag Condition="'$(_UcGitExit)' != '0'"></_UcTag>
      <_UcTag>$(_UcTag.Trim().TrimStart('v'))</_UcTag>
      <_UcTag Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_UcTag)', '^\d+\.\d+\.\d+$'))"></_UcTag>
      <Version Condition="'$(_UcTag)' != ''">$(_UcTag)</Version>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
