<Project>
  <!-- The one place the app version lives: McShared.csproj and mac/UncleCraft.Mac.csproj inherit it, and the mac
       build scripts read it (dotnet msbuild -getProperty:Version). Local builds are 0.2.0-dev (the app reads the
       -dev marker from AssemblyInformationalVersion and doesn't force updates); the release workflow passes
       -p:Version=0.2.<run_number>, which drops the marker. -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <InformationalVersion Condition="'$(Version)' == '0.2.0'">0.2.0-dev</InformationalVersion>
  </PropertyGroup>
</Project>
