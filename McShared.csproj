<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UncleCraft</AssemblyName>
    <Product>UncleCraft</Product>
    <AssemblyTitle>UncleCraft</AssemblyTitle>
    <RootNamespace>McShared</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>icon\mc-shared.ico</ApplicationIcon>
    <!-- One self-contained exe: friends don't install .NET. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The macOS build (mac/UncleCraft.Mac.csproj) is a separate project that shares the core files. -->
    <Compile Remove="mac\**;dist-mac\**" />
    <None Remove="mac\**;dist-mac\**" />
    <EmbeddedResource Remove="mac\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pixel launcher UI (WebView2). Served from the exe's resources; shots.ps1 is a dev helper and not shipped. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <EmbeddedResource Include="ui\*.html;ui\*.css;ui\*.js" LogicalName="ui/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- We use the WinForms control only; drop the package's WPF assembly (avoids a WindowsBase version conflict). -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <!-- dist should hold just UncleCraft.exe -->
  <Target Name="CleanPublishXml" AfterTargets="Publish">
    <ItemGroup><_PublishXml Include="$(PublishDir)*.xml" /></ItemGroup>
    <Delete Files="@(_PublishXml)" />
  </Target>
</Project>
